{
  "name": "@uo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:seed:prod": "node dist-seed/prisma/seed.js",
    "db:generate": "prisma generate",
    "openapi": "ts-node --transpile-only scripts/export-openapi.ts",
    "stress": "ts-node --transpile-only scripts/stress.ts",
    "forms:presets": "ts-node --transpile-only scripts/load-form-presets.ts",
    "migrate:customers": "ts-node --transpile-only scripts/migrate-customers.ts",
    "migrate:documents": "ts-node --transpile-only scripts/migrate-documents.ts",
    "flogas:fixture": "ts-node --transpile-only scripts/flogas-fixture.ts",
    "bord-gais:fixture": "ts-node --transpile-only scripts/bord-gais-fixture.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --runInBand --selectProjects integration"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "@uo/shared": "0.1.0",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "nodemailer": "10.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "22.18.6",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2"
  }
}
