// Utility Optimizer CRM — database schema.
// Conventions: UUID primary keys, snake_case tables/columns, money and rates as Decimal.
// Columns ending in `Enc` hold AES-256-GCM ciphertext (see src/common/crypto.service.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (values mirror packages/shared/src/enums.ts)
// ---------------------------------------------------------------------------

enum Role {
  administrator
  manager
  salesperson
  operations
  compliance
  finance
}

enum ServiceType {
  electricity
  gas
  dual_fuel
  merchant_services
}

enum SaleType {
  new_sale
  renewal
}

enum FormStatus {
  generated
  awaiting_review
  approved
  rejected
  superseded
}

enum CustomerPath {
  existing_client
  new_to_us
}

enum SupplyPath {
  known_supply_point
  new_supply_point
}

enum LeaseStatus {
  draft
  signed
}

enum RenewalRoute {
  full_form
  rate_card_only
}

enum ResponseOutcome {
  accepted
  changes_required
  rejected
  change_confirmed
}

enum SupplyChange {
  change_of_supplier
  change_of_legal_entity
  reenergise_meter
}

enum ProductInterest {
  electricity
  gas
  payment_services
}

enum Outcome {
  open
  won
  lost
}

enum LeadSource {
  manual
  social_media
  email
  website
  whatsapp
  referral
  existing_customer
  business_card
  csv_import
  api
  renewal
  migration
}

enum ApprovalState {
  not_requested
  pending
  approved
  rejected
}

enum VatStatus {
  yes
  no
  pending
}

enum AddressKind {
  registered
  trading
  billing
  postal
  /// Sole traders' and partners' home address (some supplier forms ask for it).
  home
}

enum PriceType {
  fixed
  variable
  fully_fixed
}

enum OccupancyType {
  owner_occupied
  rented
  landlord_supply
  other
}

enum Fuel {
  electricity
  gas
}

enum ReadingType {
  actual
  estimated
  customer
  smart
}

enum ContractStatus {
  draft
  quoted
  selected
  signed
  submitted
  live
  ended
  cancelled
}

enum SupplierKind {
  energy
  merchant
}

enum LegalEntity {
  sole_trader
  partnership
  limited_company
  plc
  charity_club
  state_body
  co_operative
  other
}

enum PrincipalRole {
  owner
  partner
  director
  shareholder
  trustee
  signatory
}

enum MerchantStatus {
  draft
  ready
  submitted
  compliance_query
  approved
  declined
  live
  cancelled
}

enum ComplianceStatus {
  not_started
  in_review
  query_raised
  approved
  rejected
}

enum DocumentApproval {
  pending
  approved
  rejected
}

enum ScanStatus {
  pending
  clean
  infected
  error
  skipped
}

enum SignatureStatus {
  draft
  sent
  partially_signed
  completed
  declined
  expired
  cancelled
}

enum SignerRole {
  customer
  broker
  /// The second holder of a joint bank account, who also signs a direct debit mandate.
  account_holder_2
}

enum SignerStatus {
  pending
  signed
  declined
}

enum ActivityType {
  call
  email
  whatsapp
  meeting
  request_documents
  review_documents
  prepare_comparison
  prepare_proposal
  obtain_signature
  internal_review
  submit_application
  follow_up_supplier
  follow_up_worldpay
  renewal_review
  compliance_review
  todo
}

enum Priority {
  low
  normal
  high
  urgent
}

enum ActivityStatus {
  open
  done
  cancelled
}

enum TimelineKind {
  call
  note
  email
  whatsapp
  stage_change
  assignment
  activity
  document
  approval
  signature
  submission
  compliance
  activation
  outcome
  system
}

enum OcrStatus {
  uploaded
  processing
  processed
  failed
  confirmed
  discarded
}

enum CommissionStatus {
  expected
  confirmed
  paid
  clawed_back
}

enum JobStatus {
  pending
  running
  succeeded
  failed
  dead
}

// ---------------------------------------------------------------------------
// Users, sessions, teams
// ---------------------------------------------------------------------------

model User {
  id                     String     @id @default(uuid()) @db.Uuid
  name                   String
  email                  String     @unique
  passwordHash           String     @map("password_hash")
  active                 Boolean    @default(true)
  roles                  UserRole[]
  teamId                 String?    @map("team_id") @db.Uuid
  team                   SalesTeam? @relation(fields: [teamId], references: [id])
  /// TOTP secret (encrypted). MFA is enforced at login when mfaEnabled is true.
  mfaSecretEnc           String?    @map("mfa_secret_enc")
  mfaEnabled             Boolean    @default(false) @map("mfa_enabled")
  /// Last TOTP time step accepted, so a code can't be used twice.
  mfaLastStep            Int?       @map("mfa_last_step")
  /// false = single sign-on only: password sign-in and password changes are refused.
  passwordLoginEnabled   Boolean    @default(true) @map("password_login_enabled")
  failedLogins           Int        @default(0) @map("failed_logins")
  lockedUntil            DateTime?  @map("locked_until")
  lastLoginAt            DateTime?  @map("last_login_at")
  /// The user's own phone (E.164). Click-to-call rings this number first, then connects the customer.
  callbackPhone          String?    @map("callback_phone")
  /// The RingCentral extension this user answers and makes calls on (matched by email), for call-log sync.
  ringcentralExtensionId String?    @unique @map("ringcentral_extension_id")
  /// false = no morning summary notification ("Needs your attention"), switched on the Account page.
  morningSummary         Boolean    @default(true) @map("morning_summary")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  sessions         Session[]
  ownedOpps        Opportunity[]     @relation("OppOwner")
  activities       Activity[]        @relation("ActivityOwner")
  notifications    Notification[]
  mailboxes        Mailbox[]
  emailSignature   EmailSignature?
  attentionDigests AttentionDigest[]

  @@map("users")
}

/// A person's email signature, added to email they send from the CRM. Starts from the company template.
model EmailSignature {
  userId      String   @id @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  enabled     Boolean  @default(true)
  fullName    String   @map("full_name")
  jobTitle    String?  @map("job_title")
  phone       String?
  mobile      String?
  email       String?
  extra       String?
  /// company | own | none
  image       String   @default("company")
  imageWidth  Int      @default(160) @map("image_width")
  accentColor String   @default("#036b5c") @map("accent_color")
  showCompany Boolean  @default(true) @map("show_company")
  /// The person's own picture (an EmailImage), used when image = own.
  ownImageId  String?  @map("own_image_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("email_signatures")
}

/// Pictures used in email signatures (company logo, people's own pictures). Served publicly by an
/// unguessable id so recipients' mail apps can load them; they are never documents.
model EmailImage {
  id           String   @id @default(uuid()) @db.Uuid
  storageKey   String   @unique @map("storage_key")
  mimeType     String   @map("mime_type")
  sha256       String
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("email_images")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  /// SHA-256 of the session token; the token itself is only ever in the cookie.
  tokenHash  String   @unique @map("token_hash")
  csrfToken  String   @map("csrf_token")
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?  @map("user_agent")
  expiresAt  DateTime @map("expires_at")
  /// Updated (at most once a minute) on use; sessions idle longer than SESSION_IDLE_MINUTES end.
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model SalesTeam {
  id    String        @id @default(uuid()) @db.Uuid
  name  String        @unique
  users User[]
  opps  Opportunity[]

  @@map("sales_teams")
}

// ---------------------------------------------------------------------------
// Pipeline & reference data
// ---------------------------------------------------------------------------

model Stage {
  id          String        @id @default(uuid()) @db.Uuid
  /// Stable key used by code and migrations. Null for admin-created extra stages.
  key         String?       @unique
  name        String
  sequence    Int
  probability Int           @default(10)
  active      Boolean       @default(true)
  opps        Opportunity[]

  @@map("stages")
}

model Supplier {
  id                      String            @id @default(uuid()) @db.Uuid
  name                    String
  kind                    SupplierKind
  /// Where "Send submission pack" emails applications. Optional.
  submissionEmail         String?           @map("submission_email")
  /// What a renewal with this supplier needs: its full form, or the signed rate card alone.
  renewalRoute            RenewalRoute      @default(full_form) @map("renewal_route")
  /// A change of legal entity also needs the outgoing account holder's consent.
  outgoingConsentRequired Boolean           @default(false) @map("outgoing_consent_required")
  /// Submissions must include a black and white copy of each signed form.
  monoCopyRequired        Boolean           @default(false) @map("mono_copy_required")
  /// Our agency / broker ID with this supplier, printed on its application forms.
  agencyId                String?           @map("agency_id")
  active                  Boolean           @default(true)
  opps                    Opportunity[]
  contracts               EnergyContract[]  @relation("SelectedSupplier")
  quotes                  ComparisonQuote[]
  formTemplates           FormTemplate[]

  @@unique([name, kind])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id                     String       @id @default(uuid()) @db.Uuid
  legalName              String       @map("legal_name")
  tradingName            String?      @map("trading_name")
  businessType           String?      @map("business_type")
  industry               String?
  companyRegNumber       String?      @map("company_reg_number")
  vatRegistered          VatStatus?   @map("vat_registered")
  vatNumber              String?      @map("vat_number")
  incorporationDate      DateTime?    @map("incorporation_date") @db.Date
  countryOfIncorporation String?      @map("country_of_incorporation")
  website                String?
  phone                  String?
  /// Last 9 digits of phone, for duplicate detection.
  phoneKey               String?      @map("phone_key")
  email                  String?
  advertisingMethod      String?      @map("advertising_method")
  // Details supplier application forms ask for.
  legalEntity            LegalEntity? @map("legal_entity")
  employees              Int?
  vatExempt              Boolean?     @map("vat_exempt")
  vatExemptNumber        String?      @map("vat_exempt_number")
  carbonTaxExempt        Boolean?     @map("carbon_tax_exempt")
  charityNumber          String?      @map("charity_number")
  /// Someone at the premises relies on life-support or medical equipment, or has special needs.
  priorityCustomer       Boolean?     @map("priority_customer")
  /// Marketing preferences (null = not asked).
  marketingEmail         Boolean?     @map("marketing_email")
  marketingPost          Boolean?     @map("marketing_post")
  marketingPhone         Boolean?     @map("marketing_phone")
  marketingSms           Boolean?     @map("marketing_sms")
  paperlessBilling       Boolean?     @map("paperless_billing")
  active                 Boolean      @default(true)
  /// Set when this record was merged into another. The record is kept, never deleted.
  mergedIntoId           String?      @map("merged_into_id") @db.Uuid
  createdById            String?      @map("created_by_id") @db.Uuid
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  addresses     CustomerAddress[]
  contacts      CustomerContact[]
  bankAccounts  BankAccount[]
  opps          Opportunity[]
  sites         SupplySite[]
  outgoingCases WorkflowCase[]    @relation("OutgoingCustomer")
  occupancies   SupplyOccupancy[]

  @@index([createdById])
  @@index([email])
  @@index([phoneKey])
  @@index([companyRegNumber])
  @@index([vatNumber])
  @@index([legalName])
  @@map("customers")
}

model CustomerAddress {
  id         String      @id @default(uuid()) @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       AddressKind @default(trading)
  line1      String
  line2      String?
  city       String?
  county     String?
  postcode   String?
  country    String      @default("IE")

  @@index([customerId])
  @@index([postcode])
  @@map("customer_addresses")
}

model CustomerContact {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Mr, Mrs, Ms, Miss or Dr.
  title      String?
  firstName  String   @map("first_name")
  lastName   String?  @map("last_name")
  jobTitle   String?  @map("job_title")
  email      String?
  phone      String?
  mobile     String?
  phoneKey   String?  @map("phone_key")
  mobileKey  String?  @map("mobile_key")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@index([email])
  @@index([phoneKey])
  @@index([mobileKey])
  @@map("customer_contacts")
}

/// Restricted (bank.read). Values encrypted; only the IBAN's last four digits are stored in clear.
model BankAccount {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accountNameEnc String   @map("account_name_enc")
  ibanEnc        String   @map("iban_enc")
  ibanLast4      String   @map("iban_last4")
  bicEnc         String?  @map("bic_enc")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("bank_accounts")
}

// ---------------------------------------------------------------------------
// Opportunities
// ---------------------------------------------------------------------------

model Opportunity {
  id                    String            @id @default(uuid()) @db.Uuid
  /// Human-friendly number shown as UO-000123.
  number                Int               @unique @default(autoincrement())
  name                  String
  customerId            String?           @map("customer_id") @db.Uuid
  customer              Customer?         @relation(fields: [customerId], references: [id])
  // Captured before a Customer exists.
  contactName           String?           @map("contact_name")
  companyName           String?           @map("company_name")
  email                 String?
  phone                 String?
  /// phoneKey(phone): matches calls from a lead's number before a customer exists.
  phoneKey              String?           @map("phone_key")
  ownerId               String?           @map("owner_id") @db.Uuid
  owner                 User?             @relation("OppOwner", fields: [ownerId], references: [id])
  teamId                String?           @map("team_id") @db.Uuid
  team                  SalesTeam?        @relation(fields: [teamId], references: [id])
  stageId               String            @map("stage_id") @db.Uuid
  stage                 Stage             @relation(fields: [stageId], references: [id])
  stageEnteredAt        DateTime          @default(now()) @map("stage_entered_at")
  /// Opportunities are permanent records. No code path sets this to false.
  active                Boolean           @default(true)
  outcome               Outcome           @default(open)
  probability           Int               @default(5)
  expectedRevenue       Decimal?          @map("expected_revenue") @db.Decimal(14, 2)
  serviceType           ServiceType       @map("service_type")
  saleType              SaleType          @default(new_sale) @map("sale_type")
  leadSource            LeadSource        @default(manual) @map("lead_source")
  leadSourceDetail      String?           @map("lead_source_detail")
  campaign              String?
  /// Persistent opportunity context, separate from timeline entries.
  notes                 String?
  nextAction            String?           @map("next_action")
  followUpDate          DateTime?         @map("follow_up_date") @db.Date
  expectedCloseDate     DateTime?         @map("expected_close_date") @db.Date
  /// Date of the site visit, if one took place.
  visitDate             DateTime?         @map("visit_date") @db.Date
  /// Role of the captured contact (owner, manager, bookkeeper...) before a Customer exists.
  contactRole           String?           @map("contact_role")
  productInterest       ProductInterest[] @default([]) @map("product_interest")
  /// What changes at the supply point; each adds required documents to the checklist.
  supplyChanges         SupplyChange[]    @default([]) @map("supply_changes")
  internalApproval      ApprovalState     @default(not_requested) @map("internal_approval")
  internalApprovalById  String?           @map("internal_approval_by_id") @db.Uuid
  internalApprovalAt    DateTime?         @map("internal_approval_at")
  selectedSupplierId    String?           @map("selected_supplier_id") @db.Uuid
  selectedSupplier      Supplier?         @relation(fields: [selectedSupplierId], references: [id])
  applicationStatus     String?           @map("application_status")
  wonAt                 DateTime?         @map("won_at")
  lostAt                DateTime?         @map("lost_at")
  lostReason            String?           @map("lost_reason")
  activationDate        DateTime?         @map("activation_date") @db.Date
  renewalDate           DateTime?         @map("renewal_date") @db.Date
  previousOpportunityId String?           @map("previous_opportunity_id") @db.Uuid
  previousOpportunity   Opportunity?      @relation("Renewals", fields: [previousOpportunityId], references: [id])
  renewals              Opportunity[]     @relation("Renewals")
  /// Identifies the contract(s) a renewal came from. Unique, so renewals can't be duplicated.
  renewalSourceKey      String?           @unique @map("renewal_source_key")
  /// The master sheet row this was imported from (scripts/migrate-customers.ts). Unique, so re-runs skip it.
  importKey             String?           @unique @map("import_key")
  firstContactAt        DateTime?         @map("first_contact_at")
  lastContactAt         DateTime?         @map("last_contact_at")
  convertedAt           DateTime?         @map("converted_at")
  createdById           String?           @map("created_by_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  stageHistory   StageHistory[]
  sites          SupplySite[]
  contracts      EnergyContract[]
  quotes         ComparisonQuote[]
  merchantApps   MerchantApplication[]
  documents      DocumentItem[]
  signatures     SignatureRequest[]
  activities     Activity[]
  timeline       TimelineEntry[]
  commissions    Commission[]
  generatedForms GeneratedForm[]
  billChecks     BillCheck[]
  workflowCase   WorkflowCase?
  supplierApps   SupplierApplication[]
  leaseChecks    LeaseCheck[]
  termsChecks    TermsCheck[]
  submissions    Submission[]

  @@index([updatedAt])
  @@index([stageId])
  @@index([ownerId])
  @@index([customerId])
  @@index([outcome])
  @@index([serviceType])
  @@index([renewalDate])
  @@index([phoneKey])
  @@map("opportunities")
}

/// One row per stage visit; drives "average time in each stage".
model StageHistory {
  id            String      @id @default(uuid()) @db.Uuid
  opportunityId String      @map("opportunity_id") @db.Uuid
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  stageId       String      @map("stage_id") @db.Uuid
  enteredAt     DateTime    @default(now()) @map("entered_at")
  leftAt        DateTime?   @map("left_at")
  userId        String?     @map("user_id") @db.Uuid

  @@index([opportunityId])
  @@map("stage_history")
}

// ---------------------------------------------------------------------------
// Energy
// ---------------------------------------------------------------------------

model SupplySite {
  id                   String         @id @default(uuid()) @db.Uuid
  customerId           String?        @map("customer_id") @db.Uuid
  customer             Customer?      @relation(fields: [customerId], references: [id])
  opportunityId        String?        @map("opportunity_id") @db.Uuid
  opportunity          Opportunity?   @relation(fields: [opportunityId], references: [id])
  label                String?
  line1                String
  line2                String?
  city                 String?
  county               String?
  postcode             String?
  country              String         @default("IE")
  serviceType          ServiceType    @map("service_type")
  occupancyType        OccupancyType? @map("occupancy_type")
  landlordName         String?        @map("landlord_name")
  landlordContact      String?        @map("landlord_contact")
  customerSector       String?        @map("customer_sector")
  annualConsumptionKwh Decimal?       @map("annual_consumption_kwh") @db.Decimal(14, 2)
  /// When the customer moved in (forms ask how long they've been at the premises).
  occupiedSince        DateTime?      @map("occupied_since") @db.Date
  leaseTerms           String?        @map("lease_terms")
  createdAt            DateTime       @default(now()) @map("created_at")

  meterPoints MeterPoint[]
  contracts   EnergyContract[]
  cases       WorkflowCase[]
  occupancies SupplyOccupancy[]

  @@index([customerId])
  @@index([opportunityId])
  @@map("supply_sites")
}

model MeterPoint {
  id                     String         @id @default(uuid()) @db.Uuid
  siteId                 String         @map("site_id") @db.Uuid
  site                   SupplySite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fuel                   Fuel
  meterType              String?        @map("meter_type")
  mprn                   String?
  gprn                   String?
  meterNumber            String?        @map("meter_number")
  mccCode                String?        @map("mcc_code")
  /// Why an identifier doesn't match the standard format (new connection, NI site...).
  formatExceptionReason  String?        @map("format_exception_reason")
  /// Electricity: maximum import capacity (kVA), DUoS group, voltage, profile class, second meter serial.
  mic                    Decimal?       @db.Decimal(10, 2)
  dgCode                 String?        @map("dg_code")
  voltage                String?
  profileClass           String?        @map("profile_class")
  meterSerial2           String?        @map("meter_serial_2")
  /// Gas: supply point capacity and annual quantity (kWh), from Gas Networks Ireland.
  supplyPointCapacityKwh Decimal?       @map("supply_point_capacity_kwh") @db.Decimal(14, 2)
  annualQuantityKwh      Decimal?       @map("annual_quantity_kwh") @db.Decimal(14, 2)
  readings               MeterReading[]

  @@index([siteId])
  @@index([mprn])
  @@index([gprn])
  @@map("meter_points")
}

model MeterReading {
  id             String      @id @default(uuid()) @db.Uuid
  meterPointId   String      @map("meter_point_id") @db.Uuid
  meterPoint     MeterPoint  @relation(fields: [meterPointId], references: [id], onDelete: Cascade)
  readingType    ReadingType @map("reading_type")
  register       String?
  value          Decimal     @db.Decimal(14, 2)
  /// The reading exactly as read ("01234.5"), so leading zeroes survive.
  rawValue       String?     @map("raw_value")
  /// Which of the meter point's meters it was read from (its serial number), when it has more than one.
  meterSerial    String?     @map("meter_serial")
  readingDate    DateTime    @map("reading_date") @db.Date
  /// Bill or photo the reading came from.
  documentItemId String?     @map("document_item_id") @db.Uuid
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([meterPointId])
  @@map("meter_readings")
}

model EnergyContract {
  id                       String         @id @default(uuid()) @db.Uuid
  opportunityId            String         @map("opportunity_id") @db.Uuid
  opportunity              Opportunity    @relation(fields: [opportunityId], references: [id])
  customerId               String?        @map("customer_id") @db.Uuid
  siteId                   String?        @map("site_id") @db.Uuid
  site                     SupplySite?    @relation(fields: [siteId], references: [id])
  fuel                     Fuel
  existingSupplierName     String?        @map("existing_supplier_name")
  existingSupplierAccount  String?        @map("existing_supplier_account")
  selectedSupplierId       String?        @map("selected_supplier_id") @db.Uuid
  selectedSupplier         Supplier?      @relation("SelectedSupplier", fields: [selectedSupplierId], references: [id])
  currentContractStartDate DateTime?      @map("current_contract_start_date") @db.Date
  currentContractEndDate   DateTime?      @map("current_contract_end_date") @db.Date
  proposedActivationDate   DateTime?      @map("proposed_activation_date") @db.Date
  activationDate           DateTime?      @map("activation_date") @db.Date
  termMonths               Int?           @map("term_months")
  /// End of the contract we placed; set at activation and drives renewals.
  contractEndDate          DateTime?      @map("contract_end_date") @db.Date
  pricingPlan              String?        @map("pricing_plan")
  dayRate                  Decimal?       @map("day_rate") @db.Decimal(10, 4)
  nightRate                Decimal?       @map("night_rate") @db.Decimal(10, 4)
  peakRate                 Decimal?       @map("peak_rate") @db.Decimal(10, 4)
  otherRate                Decimal?       @map("other_rate") @db.Decimal(10, 4)
  gasRate                  Decimal?       @map("gas_rate") @db.Decimal(10, 4)
  standingCharge           Decimal?       @map("standing_charge") @db.Decimal(10, 4)
  priceType                PriceType?     @map("price_type")
  nightStorageRate         Decimal?       @map("night_storage_rate") @db.Decimal(10, 4)
  summerDayRate            Decimal?       @map("summer_day_rate") @db.Decimal(10, 4)
  winterDayRate            Decimal?       @map("winter_day_rate") @db.Decimal(10, 4)
  supplierReference        String?        @map("supplier_reference")
  status                   ContractStatus @default(draft)
  /// The contract this one renews. Historical contracts are never modified.
  previousContractId       String?        @map("previous_contract_id") @db.Uuid
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")

  @@index([opportunityId])
  @@index([status, contractEndDate])
  @@map("energy_contracts")
}

model ComparisonQuote {
  id                  String      @id @default(uuid()) @db.Uuid
  opportunityId       String      @map("opportunity_id") @db.Uuid
  opportunity         Opportunity @relation(fields: [opportunityId], references: [id])
  supplierId          String      @map("supplier_id") @db.Uuid
  supplier            Supplier    @relation(fields: [supplierId], references: [id])
  fuel                Fuel
  termMonths          Int         @map("term_months")
  dayRate             Decimal?    @map("day_rate") @db.Decimal(10, 4)
  nightRate           Decimal?    @map("night_rate") @db.Decimal(10, 4)
  gasRate             Decimal?    @map("gas_rate") @db.Decimal(10, 4)
  standingCharge      Decimal?    @map("standing_charge") @db.Decimal(10, 4)
  estimatedAnnualCost Decimal?    @map("estimated_annual_cost") @db.Decimal(14, 2)
  estimatedCommission Decimal?    @map("estimated_commission") @db.Decimal(14, 2)
  notes               String?
  selected            Boolean     @default(false)
  createdById         String?     @map("created_by_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at")

  @@index([opportunityId])
  @@map("comparison_quotes")
}

// ---------------------------------------------------------------------------
// Worldpay
// ---------------------------------------------------------------------------

model MerchantApplication {
  id                      String         @id @default(uuid()) @db.Uuid
  opportunityId           String         @map("opportunity_id") @db.Uuid
  opportunity             Opportunity    @relation(fields: [opportunityId], references: [id])
  customerId              String?        @map("customer_id") @db.Uuid
  campaign                String?
  legalEntity             LegalEntity?   @map("legal_entity")
  natureOfBusiness        String?        @map("nature_of_business")
  estimatedAnnualTurnover Decimal?       @map("estimated_annual_turnover") @db.Decimal(14, 2)
  cardTurnoverPct         Decimal?       @map("card_turnover_pct") @db.Decimal(5, 2)
  averageTransactionValue Decimal?       @map("average_transaction_value") @db.Decimal(12, 2)
  settlementPeriod        String?        @map("settlement_period")
  dashboardRequested      Boolean        @default(false) @map("dashboard_requested")
  website                 String?
  advertisingMethod       String?        @map("advertising_method")
  applicationReference    String?        @map("application_reference")
  customerAcceptedAt      DateTime?      @map("customer_accepted_at")
  submissionDate          DateTime?      @map("submission_date") @db.Date
  approvalDate            DateTime?      @map("approval_date") @db.Date
  activationDate          DateTime?      @map("activation_date") @db.Date
  termMonths              Int?           @map("term_months")
  contractEndDate         DateTime?      @map("contract_end_date") @db.Date
  status                  MerchantStatus @default(draft)
  previousApplicationId   String?        @map("previous_application_id") @db.Uuid
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  pricing    MerchantPricing[]
  principals Principal[]
  risk       MerchantRisk?

  @@index([opportunityId])
  @@index([status, contractEndDate])
  @@map("merchant_applications")
}

model MerchantPricing {
  id                   String              @id @default(uuid()) @db.Uuid
  applicationId        String              @map("application_id") @db.Uuid
  application          MerchantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  product              String
  quantity             Int                 @default(1)
  minimumMonthlyCharge Decimal?            @map("minimum_monthly_charge") @db.Decimal(10, 2)
  productMonthlyFee    Decimal?            @map("product_monthly_fee") @db.Decimal(10, 2)
  debitRate            Decimal?            @map("debit_rate") @db.Decimal(6, 3)
  creditRate           Decimal?            @map("credit_rate") @db.Decimal(6, 3)
  commercialRate       Decimal?            @map("commercial_rate") @db.Decimal(6, 3)
  amexRate             Decimal?            @map("amex_rate") @db.Decimal(6, 3)
  authorisationFee     Decimal?            @map("authorisation_fee") @db.Decimal(8, 4)
  offerType            String?             @map("offer_type")

  @@map("merchant_pricing")
}

/// Restricted. Date of birth and nationality are encrypted; presence flags let rules run without decrypting.
model Principal {
  id             String              @id @default(uuid()) @db.Uuid
  applicationId  String              @map("application_id") @db.Uuid
  application    MerchantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  role           PrincipalRole
  title          String?
  firstName      String              @map("first_name")
  middleName     String?             @map("middle_name")
  lastName       String              @map("last_name")
  dobEnc         String?             @map("dob_enc")
  nationalityEnc String?             @map("nationality_enc")
  hasDob         Boolean             @default(false) @map("has_dob")
  hasNationality Boolean             @default(false) @map("has_nationality")
  ownershipPct   Decimal?            @map("ownership_pct") @db.Decimal(5, 2)
  email          String?
  phone          String?
  addresses      PrincipalAddress[]
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([applicationId])
  @@map("principals")
}

/// Residential address history (restricted, address encrypted).
model PrincipalAddress {
  id          String    @id @default(uuid()) @db.Uuid
  principalId String    @map("principal_id") @db.Uuid
  principal   Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  addressEnc  String    @map("address_enc")
  fromDate    DateTime  @map("from_date") @db.Date
  toDate      DateTime? @map("to_date") @db.Date

  @@index([principalId])
  @@map("principal_addresses")
}

model MerchantRisk {
  id                     String              @id @default(uuid()) @db.Uuid
  applicationId          String              @unique @map("application_id") @db.Uuid
  application            MerchantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  thirdPartyFulfilment   Boolean             @default(false) @map("third_party_fulfilment")
  stockStoredElsewhere   Boolean             @default(false) @map("stock_stored_elsewhere")
  depositsAccepted       Boolean             @default(false) @map("deposits_accepted")
  depositTxnPct          Decimal?            @map("deposit_txn_pct") @db.Decimal(5, 2)
  depositValuePct        Decimal?            @map("deposit_value_pct") @db.Decimal(5, 2)
  depositLeadDays        Int?                @map("deposit_lead_days")
  balanceLeadDays        Int?                @map("balance_lead_days")
  fullPrepaymentAccepted Boolean             @default(false) @map("full_prepayment_accepted")
  fullPrepaymentPct      Decimal?            @map("full_prepayment_pct") @db.Decimal(5, 2)
  fullPaymentLeadDays    Int?                @map("full_payment_lead_days")
  complianceStatus       ComplianceStatus    @default(not_started) @map("compliance_status")
  restrictedNotesEnc     String?             @map("restricted_notes_enc")
  reviewedById           String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt             DateTime?           @map("reviewed_at")

  @@map("merchant_risk")
}

// ---------------------------------------------------------------------------
// Documents & signatures
// ---------------------------------------------------------------------------

model DocumentItem {
  id                    String            @id @default(uuid()) @db.Uuid
  opportunityId         String            @map("opportunity_id") @db.Uuid
  opportunity           Opportunity       @relation(fields: [opportunityId], references: [id])
  customerId            String?           @map("customer_id") @db.Uuid
  merchantApplicationId String?           @map("merchant_application_id") @db.Uuid
  energyContractId      String?           @map("energy_contract_id") @db.Uuid
  documentType          String            @map("document_type")
  required              Boolean           @default(true)
  sensitive             Boolean           @default(false)
  requestedAt           DateTime?         @map("requested_at")
  received              Boolean           @default(false)
  receivedAt            DateTime?         @map("received_at")
  approval              DocumentApproval  @default(pending)
  reviewerId            String?           @map("reviewer_id") @db.Uuid
  reviewedAt            DateTime?         @map("reviewed_at")
  reviewNotes           String?           @map("review_notes")
  expiryDate            DateTime?         @map("expiry_date") @db.Date
  createdAt             DateTime          @default(now()) @map("created_at")
  versions              DocumentVersion[]

  @@index([opportunityId])
  @@index([expiryDate])
  @@map("document_items")
}

/// Every upload is a new version; nothing is overwritten.
model DocumentVersion {
  id           String       @id @default(uuid()) @db.Uuid
  itemId       String       @map("item_id") @db.Uuid
  item         DocumentItem @relation(fields: [itemId], references: [id])
  version      Int
  storageKey   String       @unique @map("storage_key")
  filename     String
  mimeType     String       @map("mime_type")
  size         Int
  sha256       String
  scanStatus   ScanStatus   @default(pending) @map("scan_status")
  uploadedById String?      @map("uploaded_by_id") @db.Uuid
  uploadedAt   DateTime     @default(now()) @map("uploaded_at")

  @@unique([itemId, version])
  @@map("document_versions")
}

/// A supplier PDF with positioned fields. Field layout changes bump `version`; generated forms keep a snapshot.
model FormTemplate {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  supplierId   String?         @map("supplier_id") @db.Uuid
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])
  documentType String          @map("document_type")
  version      Int             @default(1)
  storageKey   String          @unique @map("storage_key")
  filename     String
  sha256       String
  /// [{ width, height }] in PDF points, one per page.
  pages        Json
  /// FormField[] (see @uo/shared formFieldSchema).
  fields       Json
  /// Set for a supplier PDF filled by a dedicated application (e.g. "flogas_electricity"): its layout
  /// lives in code, and the generic "fill a supplier form" list doesn't offer it.
  workflow     String?
  active       Boolean         @default(true)
  createdById  String?         @map("created_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  forms        GeneratedForm[]

  @@index([supplierId])
  @@map("form_templates")
}

/// One filled copy of a template for an opportunity. Never edited; regenerating supersedes it.
model GeneratedForm {
  id                     String                      @id @default(uuid()) @db.Uuid
  opportunityId          String                      @map("opportunity_id") @db.Uuid
  opportunity            Opportunity                 @relation(fields: [opportunityId], references: [id])
  templateId             String                      @map("template_id") @db.Uuid
  template               FormTemplate                @relation(fields: [templateId], references: [id])
  templateVersion        Int                         @map("template_version")
  /// Field layout used, so the exact copy can be reproduced.
  fields                 Json
  /// Encrypted JSON of the values written (may include an IBAN).
  valuesEnc              String                      @map("values_enc")
  /// Field ids whose value was typed or changed instead of coming from the CRM.
  changedFields          Json                        @default("[]") @map("changed_fields")
  ibanChangeConfirmed    Boolean                     @default(false) @map("iban_change_confirmed")
  documentItemId         String                      @map("document_item_id") @db.Uuid
  /// The unsigned generated PDF.
  versionId              String                      @map("version_id") @db.Uuid
  /// The PDF with signatures applied, once every required signer has one, or the uploaded signed copy.
  signedVersionId        String?                     @map("signed_version_id") @db.Uuid
  /// Set when signedVersionId is a scan of the form signed on paper (uploaded, not built from signatures).
  signedCopyUploadedById String?                     @map("signed_copy_uploaded_by_id") @db.Uuid
  signedCopyUploadedAt   DateTime?                   @map("signed_copy_uploaded_at")
  /// Black and white copy of the signed (or unsigned) PDF, for suppliers that need one.
  monoVersionId          String?                     @map("mono_version_id") @db.Uuid
  /// The customer's previous form from the same template (renewals), compared field by field.
  previousFormId         String?                     @map("previous_form_id") @db.Uuid
  /// Labels of fields whose value differs from the previous form.
  changedSincePrevious   Json                        @default("[]") @map("changed_since_previous")
  changeReason           String?                     @map("change_reason")
  status                 FormStatus                  @default(generated)
  qcPassed               Boolean                     @map("qc_passed")
  qcIssues               Json                        @default("[]") @map("qc_issues")
  reviewedById           String?                     @map("reviewed_by_id") @db.Uuid
  reviewedAt             DateTime?                   @map("reviewed_at")
  reviewNote             String?                     @map("review_note")
  createdById            String?                     @map("created_by_id") @db.Uuid
  createdAt              DateTime                    @default(now()) @map("created_at")
  signatures             FormSignature[]
  signingLinks           SigningLink[]
  applicationVersion     SupplierApplicationVersion?

  @@index([opportunityId])
  @@map("generated_forms")
}

/// An uploaded signature image, authorised for one generated form only.
model FormSignature {
  id              String        @id @default(uuid()) @db.Uuid
  formId          String        @map("form_id") @db.Uuid
  form            GeneratedForm @relation(fields: [formId], references: [id])
  role            SignerRole
  signerName      String        @map("signer_name")
  signerCapacity  String?       @map("signer_capacity")
  authorisation   String
  note            String?
  storageKey      String        @unique @map("storage_key")
  sha256          String
  uploadedById    String?       @map("uploaded_by_id") @db.Uuid
  uploadedAt      DateTime      @default(now()) @map("uploaded_at")
  /// Set when the signer drew the signature on the online signing page; the columns below are its evidence.
  signingLinkId   String?       @unique @map("signing_link_id") @db.Uuid
  signingLink     SigningLink?  @relation(fields: [signingLinkId], references: [id], onDelete: Restrict)
  signerEmail     String?       @map("signer_email")
  signerIp        String?       @map("signer_ip")
  signerUserAgent String?       @map("signer_user_agent")
  /// Version and wording of the consent the signer ticked.
  consentText     String?       @map("consent_text")
  /// sha256 of the unsigned PDF the signer was shown.
  documentSha256  String?       @map("document_sha256")

  @@index([formId])
  @@map("form_signatures")
}

/// An emailed link that lets one signer sign one generated form online. Only the token's hash is stored.
model SigningLink {
  id            String         @id @default(uuid()) @db.Uuid
  formId        String         @map("form_id") @db.Uuid
  form          GeneratedForm  @relation(fields: [formId], references: [id])
  role          SignerRole
  signerName    String         @map("signer_name")
  signerEmail   String         @map("signer_email")
  tokenHash     String         @unique @map("token_hash")
  expiresAt     DateTime       @map("expires_at")
  openedAt      DateTime?      @map("opened_at")
  signedAt      DateTime?      @map("signed_at")
  revokedAt     DateTime?      @map("revoked_at")
  /// The signer refused to sign; the link no longer works.
  declinedAt    DateTime?      @map("declined_at")
  declineReason String?        @map("decline_reason")
  lastSentAt    DateTime       @default(now()) @map("last_sent_at")
  createdById   String?        @map("created_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  signature     FormSignature?

  @@index([formId])
  @@map("signing_links")
}

/// A supplier's own application on an opportunity (e.g. the Flogas electricity agreement). Customer,
/// site, meter, contract and bank details stay on their CRM records; this keeps only the answers the
/// supplier's form asks for that have no other home. Never deleted.
model SupplierApplication {
  id            String                       @id @default(uuid()) @db.Uuid
  opportunityId String                       @map("opportunity_id") @db.Uuid
  opportunity   Opportunity                  @relation(fields: [opportunityId], references: [id])
  /// "flogas_electricity"
  kind          String
  /// Supplier-specific answers (see @uo/shared flogasAnswersSchema).
  answers       Json                         @default("{}")
  /// Encrypted JSON of restricted answers (a separate debtor address).
  restrictedEnc String?                      @map("restricted_enc")
  createdById   String?                      @map("created_by_id") @db.Uuid
  updatedById   String?                      @map("updated_by_id") @db.Uuid
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")
  versions      SupplierApplicationVersion[]

  @@unique([opportunityId, kind])
  @@map("supplier_applications")
}

/// One generated document of an application and the exact data it was made from. Append-only.
model SupplierApplicationVersion {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @map("application_id") @db.Uuid
  application   SupplierApplication @relation(fields: [applicationId], references: [id])
  version       Int
  /// The generated PDF, its field snapshot, values, signing links and signatures.
  formId        String              @unique @map("form_id") @db.Uuid
  form          GeneratedForm       @relation(fields: [formId], references: [id])
  /// The coordinate layout (layout.ts) used.
  layoutVersion String              @map("layout_version")
  /// Encrypted JSON snapshot of the application data (may include an IBAN).
  dataEnc       String              @map("data_enc")
  /// Hash of the data, to spot CRM edits made after this version was generated.
  dataSha256    String              @map("data_sha256")
  createdById   String?             @map("created_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")

  @@unique([applicationId, version])
  @@map("supplier_application_versions")
}

/// Verification of the previous supplier's bill for a change of supplier.
model BillCheck {
  id                  String      @id @default(uuid()) @db.Uuid
  opportunityId       String      @map("opportunity_id") @db.Uuid
  opportunity         Opportunity @relation(fields: [opportunityId], references: [id])
  /// The bill version that was checked; a newer upload needs a new check.
  documentVersionId   String      @map("document_version_id") @db.Uuid
  previousSupplier    String      @map("previous_supplier")
  billDate            DateTime?   @map("bill_date") @db.Date
  readable            Boolean
  customerNameMatches Boolean     @map("customer_name_matches")
  supplyPointMatches  Boolean     @map("supply_point_matches")
  supplierMatches     Boolean     @map("supplier_matches")
  passed              Boolean
  notes               String?
  verifiedById        String?     @map("verified_by_id") @db.Uuid
  verifiedAt          DateTime    @default(now()) @map("verified_at")

  @@index([opportunityId])
  @@map("bill_checks")
}

/// The back-office case on an opportunity: how the request came in, the customer and supply
/// paths, and for a change of entity the supply point taken over and the outgoing account.
model WorkflowCase {
  id                   String        @id @default(uuid()) @db.Uuid
  opportunityId        String        @unique @map("opportunity_id") @db.Uuid
  opportunity          Opportunity   @relation(fields: [opportunityId], references: [id])
  customerPath         CustomerPath? @map("customer_path")
  requestChannel       String?       @map("request_channel")
  requestReceivedAt    DateTime?     @map("request_received_at") @db.Date
  requestNote          String?       @map("request_note")
  supplyPath           SupplyPath?   @map("supply_path")
  /// A supply site already in our records (known supply point). It keeps its history.
  siteId               String?       @map("site_id") @db.Uuid
  site                 SupplySite?   @relation(fields: [siteId], references: [id])
  outgoingCustomerId   String?       @map("outgoing_customer_id") @db.Uuid
  outgoingCustomer     Customer?     @relation("OutgoingCustomer", fields: [outgoingCustomerId], references: [id])
  outgoingAccountRef   String?       @map("outgoing_account_ref")
  outgoingContractRef  String?       @map("outgoing_contract_ref")
  occupancyDate        DateTime?     @map("occupancy_date") @db.Date
  /// Where a new supply point's MPRN/GPRN and address came from, and who verified it.
  supplySource         String?       @map("supply_source")
  supplyVerifiedById   String?       @map("supply_verified_by_id") @db.Uuid
  supplyVerifiedAt     DateTime?     @map("supply_verified_at")
  noticeDeadline       DateTime?     @map("notice_deadline") @db.Date
  targetSubmissionDate DateTime?     @map("target_submission_date") @db.Date
  createdById          String?       @map("created_by_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@index([siteId])
  @@index([outgoingCustomerId])
  @@map("workflow_cases")
}

/// A check of one lease version. Append-only: a draft and the signed copy are separate rows.
model LeaseCheck {
  id                String      @id @default(uuid()) @db.Uuid
  opportunityId     String      @map("opportunity_id") @db.Uuid
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id])
  documentVersionId String      @map("document_version_id") @db.Uuid
  status            LeaseStatus
  landlordName      String      @map("landlord_name")
  tenantName        String      @map("tenant_name")
  tenancyStartDate  DateTime?   @map("tenancy_start_date") @db.Date
  landlordMatches   Boolean     @map("landlord_matches")
  tenantMatches     Boolean     @map("tenant_matches")
  addressMatches    Boolean     @map("address_matches")
  datesMatch        Boolean     @map("dates_match")
  signedByLandlord  Boolean     @map("signed_by_landlord")
  signedByTenant    Boolean     @map("signed_by_tenant")
  passed            Boolean
  notes             String?
  verifiedById      String?     @map("verified_by_id") @db.Uuid
  verifiedAt        DateTime    @default(now()) @map("verified_at")

  @@index([opportunityId])
  @@map("lease_checks")
}

/// Admin's verification of the proposed terms. Only counts while the terms are unchanged (hash).
model TermsCheck {
  id            String      @id @default(uuid()) @db.Uuid
  opportunityId String      @map("opportunity_id") @db.Uuid
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  snapshotHash  String      @map("snapshot_hash")
  /// The terms that were verified (rates, term, dates, supplier); no personal data.
  terms         Json
  verifiedById  String?     @map("verified_by_id") @db.Uuid
  verifiedAt    DateTime    @default(now()) @map("verified_at")

  @@index([opportunityId])
  @@map("terms_checks")
}

/// What was sent to the external party: recipient, channel, the exact file versions and proof of delivery.
model Submission {
  id               String               @id @default(uuid()) @db.Uuid
  opportunityId    String               @map("opportunity_id") @db.Uuid
  opportunity      Opportunity          @relation(fields: [opportunityId], references: [id])
  recipient        String
  channel          String
  sentAt           DateTime             @map("sent_at") @db.Date
  /// [{ documentVersionId, documentType, filename, version, sha256 }] as sent.
  files            Json
  deliveryEvidence String               @map("delivery_evidence")
  note             String?
  recordedById     String?              @map("recorded_by_id") @db.Uuid
  recordedAt       DateTime             @default(now()) @map("recorded_at")
  responses        SubmissionResponse[]

  @@index([opportunityId])
  @@map("submissions")
}

/// The external party's answer to a submission. Append-only.
model SubmissionResponse {
  id                String          @id @default(uuid()) @db.Uuid
  submissionId      String          @map("submission_id") @db.Uuid
  submission        Submission      @relation(fields: [submissionId], references: [id])
  opportunityId     String          @map("opportunity_id") @db.Uuid
  outcome           ResponseOutcome
  receivedVia       String          @map("received_via")
  receivedAt        DateTime        @map("received_at") @db.Date
  externalReference String?         @map("external_reference")
  effectiveDate     DateTime?       @map("effective_date") @db.Date
  reason            String?
  correctionOwnerId String?         @map("correction_owner_id") @db.Uuid
  correctionDueDate DateTime?       @map("correction_due_date") @db.Date
  recordedById      String?         @map("recorded_by_id") @db.Uuid
  recordedAt        DateTime        @default(now()) @map("recorded_at")

  @@index([submissionId])
  @@index([opportunityId])
  @@map("submission_responses")
}

/// Who occupies a supply point from when. Append-only, so the outgoing customer's history is kept.
model SupplyOccupancy {
  id            String     @id @default(uuid()) @db.Uuid
  siteId        String     @map("site_id") @db.Uuid
  site          SupplySite @relation(fields: [siteId], references: [id])
  customerId    String     @map("customer_id") @db.Uuid
  customer      Customer   @relation(fields: [customerId], references: [id])
  /// Null when the start is unknown (an occupant recorded before this history existed).
  fromDate      DateTime?  @map("from_date") @db.Date
  opportunityId String?    @map("opportunity_id") @db.Uuid
  recordedById  String?    @map("recorded_by_id") @db.Uuid
  recordedAt    DateTime   @default(now()) @map("recorded_at")

  @@index([siteId])
  @@index([customerId])
  @@map("supply_occupancies")
}

model SignatureTemplate {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  provider           String
  providerTemplateId String?            @map("provider_template_id")
  serviceType        ServiceType?       @map("service_type")
  active             Boolean            @default(true)
  requests           SignatureRequest[]

  @@map("signature_templates")
}

model SignatureRequest {
  id                String             @id @default(uuid()) @db.Uuid
  opportunityId     String             @map("opportunity_id") @db.Uuid
  opportunity       Opportunity        @relation(fields: [opportunityId], references: [id])
  templateId        String?            @map("template_id") @db.Uuid
  template          SignatureTemplate? @relation(fields: [templateId], references: [id])
  documentItemId    String?            @map("document_item_id") @db.Uuid
  title             String
  provider          String
  providerRequestId String?            @unique @map("provider_request_id")
  status            SignatureStatus    @default(draft)
  requestedAt       DateTime?          @map("requested_at")
  lastReminderAt    DateTime?          @map("last_reminder_at")
  completedAt       DateTime?          @map("completed_at")
  /// The signed document, stored as a DocumentVersion.
  signedVersionId   String?            @map("signed_version_id") @db.Uuid
  createdById       String?            @map("created_by_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  signers           Signer[]

  @@index([opportunityId])
  @@map("signature_requests")
}

model Signer {
  id        String           @id @default(uuid()) @db.Uuid
  requestId String           @map("request_id") @db.Uuid
  request   SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  role      SignerRole
  name      String
  email     String
  status    SignerStatus     @default(pending)
  signedAt  DateTime?        @map("signed_at")

  @@map("signers")
}

// ---------------------------------------------------------------------------
// Activities, timeline, audit, notifications
// ---------------------------------------------------------------------------

model Activity {
  id             String         @id @default(uuid()) @db.Uuid
  type           ActivityType
  summary        String
  note           String?
  dueDate        DateTime       @map("due_date") @db.Date
  priority       Priority       @default(normal)
  status         ActivityStatus @default(open)
  reminderAt     DateTime?      @map("reminder_at")
  reminderSentAt DateTime?      @map("reminder_sent_at")
  ownerId        String?        @map("owner_id") @db.Uuid
  owner          User?          @relation("ActivityOwner", fields: [ownerId], references: [id])
  opportunityId  String?        @map("opportunity_id") @db.Uuid
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id])
  customerId     String?        @map("customer_id") @db.Uuid
  /// Set by automations: at most one OPEN activity per (opportunity, key). Enforced by a partial unique index.
  automationKey  String?        @map("automation_key")
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  completedAt    DateTime?      @map("completed_at")

  @@index([ownerId, status, dueDate])
  @@index([opportunityId])
  @@map("activities")
}

/// Append-only (a database trigger blocks UPDATE and DELETE). Corrections are new entries with `correctsId`.
model TimelineEntry {
  id            String       @id @default(uuid()) @db.Uuid
  opportunityId String?      @map("opportunity_id") @db.Uuid
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  customerId    String?      @map("customer_id") @db.Uuid
  kind          TimelineKind
  body          String
  direction     String?
  data          Json?
  actorId       String?      @map("actor_id") @db.Uuid
  occurredAt    DateTime     @default(now()) @map("occurred_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  correctsId    String?      @map("corrects_id") @db.Uuid

  @@index([opportunityId, occurredAt])
  @@index([customerId, occurredAt])
  @@map("timeline_entries")
}

/// Append-only security/audit log (trigger-protected). Never contains sensitive values.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  summary    String
  data       Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

/// One morning summary per user per Irish day: the unique key makes the job safe to run twice.
model AttentionDigest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  /// The counts that were sent: { stuck, overdueTasks, followUps, renewals }.
  counts    Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, day])
  @@map("attention_digests")
}

// ---------------------------------------------------------------------------
// OCR, commissions, integrations, settings
// ---------------------------------------------------------------------------

model BusinessCardScan {
  id            String    @id @default(uuid()) @db.Uuid
  storageKey    String    @unique @map("storage_key")
  filename      String
  mimeType      String    @map("mime_type")
  provider      String
  status        OcrStatus @default(uploaded)
  confidence    Decimal?  @db.Decimal(4, 3)
  rawText       String?   @map("raw_text")
  parsed        Json?
  error         String?
  customerId    String?   @map("customer_id") @db.Uuid
  opportunityId String?   @map("opportunity_id") @db.Uuid
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("business_card_scans")
}

model Commission {
  id            String           @id @default(uuid()) @db.Uuid
  opportunityId String           @map("opportunity_id") @db.Uuid
  opportunity   Opportunity      @relation(fields: [opportunityId], references: [id])
  amount        Decimal          @db.Decimal(14, 2)
  status        CommissionStatus @default(expected)
  note          String?
  createdById   String?          @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([opportunityId])
  @@map("commissions")
}

/// Outbound integration work (supplier/Worldpay submission, email, WhatsApp, accounting).
/// Executed by BullMQ with retries; jobs that exhaust retries become `dead` (dead-letter).
model IntegrationJob {
  id             String    @id @default(uuid()) @db.Uuid
  kind           String
  opportunityId  String?   @map("opportunity_id") @db.Uuid
  payload        Json
  status         JobStatus @default(pending)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  result         Json?
  idempotencyKey String    @unique @map("idempotency_key")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("integration_jobs")
}

/// Inbound webhooks, recorded once per provider event id (idempotency).
model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  payload     Json
  status      JobStatus @default(pending)
  error       String?
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Internal chat
// ---------------------------------------------------------------------------

enum ChatChannelKind {
  direct
  channel
  deal
}

/// A conversation: a direct message between two users, a team channel, or the internal discussion on one opportunity.
model ChatChannel {
  id            String          @id @default(uuid()) @db.Uuid
  kind          ChatChannelKind
  name          String?
  description   String?
  /// Private channels are visible to members only. Public channels can be joined by any staff member.
  isPrivate     Boolean         @default(false) @map("is_private")
  /// For direct messages: the two user ids sorted and joined, so a pair has exactly one conversation.
  directKey     String?         @unique @map("direct_key")
  /// For deal discussions: access follows the opportunity's permissions.
  opportunityId String?         @unique @map("opportunity_id") @db.Uuid
  archived      Boolean         @default(false)
  createdById   String?         @map("created_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  lastMessageAt DateTime?       @map("last_message_at")

  members  ChatMember[]
  messages ChatMessage[]

  @@map("chat_channels")
}

model ChatMember {
  channelId  String      @map("channel_id") @db.Uuid
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String      @map("user_id") @db.Uuid
  lastReadAt DateTime    @default(now()) @map("last_read_at")
  muted      Boolean     @default(false)
  joinedAt   DateTime    @default(now()) @map("joined_at")

  @@id([channelId, userId])
  @@index([userId])
  @@map("chat_members")
}

model ChatMessage {
  id          String                @id @default(uuid()) @db.Uuid
  channelId   String                @map("channel_id") @db.Uuid
  channel     ChatChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String?               @map("author_id") @db.Uuid
  /// Null once deleted (the text is kept in chat_message_revisions).
  body        String?
  mentions    String[]              @default([]) @db.Uuid
  editedAt    DateTime?             @map("edited_at")
  deletedAt   DateTime?             @map("deleted_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  attachments ChatAttachment[]
  revisions   ChatMessageRevision[]

  @@index([channelId, createdAt])
  @@map("chat_messages")
}

/// Previous text of edited or deleted messages (append-only), for administrators and disputes.
model ChatMessageRevision {
  id        String      @id @default(uuid()) @db.Uuid
  messageId String      @map("message_id") @db.Uuid
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("chat_message_revisions")
}

model ChatAttachment {
  id         String      @id @default(uuid()) @db.Uuid
  messageId  String      @map("message_id") @db.Uuid
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageKey String      @unique @map("storage_key")
  filename   String
  mimeType   String      @map("mime_type")
  size       Int
  sha256     String
  scanStatus ScanStatus  @default(pending) @map("scan_status")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("chat_attachments")
}

// ---------------------------------------------------------------------------
// Customer calls (click-to-call)
// ---------------------------------------------------------------------------

enum CallStatus {
  initiated
  ringing_agent
  ringing_customer
  in_progress
  completed
  no_answer
  busy
  failed
  canceled
}

model CallLog {
  id                 String      @id @default(uuid()) @db.Uuid
  opportunityId      String?     @map("opportunity_id") @db.Uuid
  customerId         String?     @map("customer_id") @db.Uuid
  contactId          String?     @map("contact_id") @db.Uuid
  /// The staff member on the call; null for calls to a company number nobody in the CRM answered.
  userId             String?     @map("user_id") @db.Uuid
  /// inbound | outbound
  direction          String      @default("outbound")
  /// The customer's number (E.164), whichever way the call went.
  toNumber           String      @map("to_number")
  /// Our side of the call (E.164): the phone rung first for click-to-call, or the number called for inbound calls.
  agentNumber        String?     @map("agent_number")
  provider           String
  providerCallId     String?     @unique @map("provider_call_id")
  /// RingCentral call-log record id: calls imported from the call log (and click-to-calls matched to theirs) are stored once.
  rcRecordId         String?     @unique @map("rc_record_id")
  rcSessionId        String?     @map("rc_session_id")
  /// Recording (RINGCENTRAL_RECORDINGS=true): downloaded into our storage, virus-scanned, deleted after the retention period.
  rcRecordingId      String?     @map("rc_recording_id")
  recordingKey       String?     @map("recording_key")
  recordingMime      String?     @map("recording_mime")
  recordingSize      Int?        @map("recording_size")
  recordingScan      ScanStatus? @map("recording_scan")
  recordingDeletedAt DateTime?   @map("recording_deleted_at")
  status             CallStatus  @default(initiated)
  startedAt          DateTime    @default(now()) @map("started_at")
  answeredAt         DateTime?   @map("answered_at")
  endedAt            DateTime?   @map("ended_at")
  durationSec        Int?        @map("duration_sec")
  outcome            String?
  notes              String?
  /// Set once the call has been written to the opportunity timeline (exactly once).
  loggedAt           DateTime?   @map("logged_at")

  @@index([opportunityId, startedAt])
  @@index([rcSessionId])
  @@index([userId, startedAt])
  @@map("call_logs")
}

// --- Email: each user's own Microsoft 365 or Google mailbox ------------------------------------

enum MailProviderId {
  microsoft
  google
}

enum MailboxStatus {
  active
  /// The provider refused the refresh token (password change, revoked consent): the owner reconnects.
  reauth_required
  disconnected
}

/// A user's connected mailbox. Tokens are encrypted; the address always equals the user's CRM email.
model Mailbox {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  user         User           @relation(fields: [userId], references: [id])
  provider     MailProviderId
  address      String
  /// {accessToken, refreshToken, expiresAt} via CryptoService.encryptJson. Never logged or returned.
  tokensEnc    String?        @map("tokens_enc")
  status       MailboxStatus  @default(active)
  /// Provider sync cursor: Graph delta links per folder, or the Gmail historyId.
  syncState    Json?          @map("sync_state")
  lastSyncedAt DateTime?      @map("last_synced_at")
  lastError    String?        @map("last_error")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  messages EmailMessage[]

  @@unique([userId, provider])
  @@map("mailboxes")
}

/// One email from a connected mailbox (inbox or sent). Kept after a mailbox is disconnected; never deleted.
model EmailMessage {
  id                String    @id @default(uuid()) @db.Uuid
  mailboxId         String    @map("mailbox_id") @db.Uuid
  mailbox           Mailbox   @relation(fields: [mailboxId], references: [id])
  providerMessageId String    @map("provider_message_id")
  threadId          String?   @map("thread_id")
  /// RFC 5322 Message-ID, used for reply threading.
  internetMessageId String?   @map("internet_message_id")
  direction         String
  fromAddress       String    @map("from_address")
  fromName          String?   @map("from_name")
  toAddresses       String[]  @map("to_addresses")
  ccAddresses       String[]  @map("cc_addresses")
  subject           String
  snippet           String
  /// Plain text (HTML is converted on the server and never rendered), encrypted at rest.
  bodyEnc           String?   @map("body_enc")
  sentAt            DateTime  @map("sent_at")
  unread            Boolean   @default(false)
  hasAttachments    Boolean   @default(false) @map("has_attachments")
  customerId        String?   @map("customer_id") @db.Uuid
  opportunityId     String?   @map("opportunity_id") @db.Uuid
  /// Set once the email has been written to the customer/opportunity timeline (exactly once).
  timelineLoggedAt  DateTime? @map("timeline_logged_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([mailboxId, providerMessageId])
  @@index([mailboxId, direction, sentAt])
  @@index([opportunityId, sentAt])
  @@index([customerId, sentAt])
  @@index([threadId])
  @@map("email_messages")
}

/// A conversation with the CRM assistant. Only its owner reads it; purged after 90 days.
model AssistantConversation {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  /// The deal the conversation started on, if any.
  opportunityId String?            @map("opportunity_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")
  messages      AssistantMessage[]

  @@index([userId, createdAt])
  @@map("assistant_conversations")
}

/// Append-only (trigger-protected). Bodies hold no restricted values: the assistant's tools never return them.
model AssistantMessage {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id])
  /// "user" or "assistant".
  role           String
  body           String
  toolsUsed      String[]              @map("tools_used")
  model          String?
  inputTokens    Int?                  @map("input_tokens")
  outputTokens   Int?                  @map("output_tokens")
  createdAt      DateTime              @default(now()) @map("created_at")
  feedback       AssistantFeedback[]
  actions        AssistantAction[]

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

/// Thumbs up or down on an answer (append-only); the unhelpful ones are reviewed to improve the instructions.
model AssistantFeedback {
  id        String           @id @default(uuid()) @db.Uuid
  messageId String           @map("message_id") @db.Uuid
  message   AssistantMessage @relation(fields: [messageId], references: [id])
  userId    String           @map("user_id") @db.Uuid
  helpful   Boolean
  comment   String?
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([helpful, createdAt])
  @@map("assistant_feedback")
}

/// A change the assistant prepared (see ASSISTANT_ACTION_KINDS). Nothing happens until the user
/// confirms it; the change is then made through the usual services as that user. A trigger allows
/// only the status moves pending → confirming → done | failed and pending → dismissed.
model AssistantAction {
  id            String           @id @default(uuid()) @db.Uuid
  /// The answer that offered it.
  messageId     String           @map("message_id") @db.Uuid
  message       AssistantMessage @relation(fields: [messageId], references: [id])
  userId        String           @map("user_id") @db.Uuid
  kind          String
  /// One sentence shown on the card, e.g. "Call Mary Murphy on 3 Nov (UO-000123)".
  summary       String
  /// The change, validated with ASSISTANT_ACTION_PAYLOADS[kind]. No restricted values.
  payload       Json
  opportunityId String?          @map("opportunity_id") @db.Uuid
  status        String           @default("pending")
  /// Why it couldn't be done (user-facing), when status is failed.
  error         String?
  /// What was created or changed, e.g. { activityId } or { opportunityId }.
  result        Json?
  decidedAt     DateTime?        @map("decided_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([messageId])
  @@index([userId, createdAt])
  @@map("assistant_actions")
}

/// A customer import from the master sheet run from Administration (dry run or real). The sheet is
/// kept in storage so a dry run can be imported without uploading it again; purged after 90 days.
model ImportRun {
  id          String    @id @default(uuid()) @db.Uuid
  /// "dry_run" or "import".
  mode        String
  /// "running", "done" or "failed".
  status      String    @default("running")
  filename    String
  storageKey  String    @map("storage_key")
  sha256      String
  /// Options used: allowFormatExceptions, createSuppliers, agents (sheet name -> user id or null).
  options     Json
  /// Counts, statuses, unmatched agents, suppliers to create, renewals and meter checks.
  summary     Json?
  /// One entry per sheet row: what happened and why.
  lines       Json?
  error       String?
  /// The dry run an import was confirmed from.
  fromRunId   String?   @map("from_run_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  finishedAt  DateTime? @map("finished_at")

  @@index([createdAt])
  @@map("import_runs")
}
