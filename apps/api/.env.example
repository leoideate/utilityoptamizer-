# Copy to apps/api/.env for local development. Values below match docker-compose.yml.
# Never commit a real .env. In production use your platform's secret store.

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

DATABASE_URL=postgresql://uo:uo_local_dev@127.0.0.1:5433/uo_crm
# Used by `npm run test:integration` (database created by infra/postgres/init).
TEST_DATABASE_URL=postgresql://uo:uo_local_dev@127.0.0.1:5433/uo_crm_test
REDIS_URL=redis://127.0.0.1:6379

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# Only during key rotation: the previous key, so existing values still decrypt.
FIELD_ENCRYPTION_KEY_PREVIOUS=
# 32+ random characters:    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

SESSION_TTL_HOURS=12
# Sign out after this many minutes without activity.
SESSION_IDLE_MINUTES=60
# Must be true in production (HTTPS).
COOKIE_SECURE=false

STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=eu-west-1
S3_BUCKET=uo-documents
S3_ACCESS_KEY_ID=uo_s3
S3_SECRET_ACCESS_KEY=uo_s3_local_dev
S3_FORCE_PATH_STYLE=true
# Local SeaweedFS hands back SSE-S3 objects still encrypted, so it's off here. Keep AES256 (the default) on AWS S3.
S3_SERVER_SIDE_ENCRYPTION=none
DOWNLOAD_URL_TTL_SECONDS=300
MAX_UPLOAD_MB=20

# Requests per minute per client IP (login has its own limit of 10/minute).
RATE_LIMIT_PER_MINUTE=300
# Production: the API only sees the web app's address unless this is set, so every user would share
# one rate limit. Set it ONLY when a reverse proxy / load balancer that sets X-Forwarded-For sits in
# front of the web app, e.g.  TRUST_PROXY=loopback,linklocal,uniquelocal
TRUST_PROXY=
# Interactive docs at /api/docs: on by default in development, off in production.
ENABLE_API_DOCS=

# none | clamav
VIRUS_SCAN_DRIVER=none

# Mailpit in development: http://localhost:8025
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Utility Optimizer CRM <crm@utilityoptimizer.com>"

# manual | http   (http: see docs/administrator-guide.md "OCR")
OCR_PROVIDER=manual
OCR_HTTP_ENDPOINT=
OCR_HTTP_API_KEY=

# manual | webhook
SIGNATURE_PROVIDER=manual
SIGNATURE_WEBHOOK_SECRET=

# Single sign-on (optional). Register this redirect URI with each provider:
#   {WEB_ORIGIN}/api/auth/sso/microsoft/callback   and   {WEB_ORIGIN}/api/auth/sso/google/callback
# Users must already exist in the CRM (matched by email); SSO never creates accounts.
SSO_MICROSOFT_TENANT_ID=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
# Comma-separated, e.g. utilityoptimizer.com,utilityoptimizer.ie (recommended)
SSO_ALLOWED_DOMAINS=

# Mailboxes: each person connects their own Outlook or Gmail on their Account page, using the SSO app
# registrations above with mail permissions. Register this redirect URI with each provider too:
#   {WEB_ORIGIN}/api/mailboxes/microsoft/callback   and   {WEB_ORIGIN}/api/mailboxes/google/callback
# How far back to fetch mail on first connect (days).
MAIL_BACKFILL_DAYS=30

# Click-to-call: manual (opens the device dialler) or ringcentral (RingOut).
TELEPHONY_PROVIDER=manual
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
# Company number customers see (E.164, must belong to the RingCentral user). Optional.
RINGCENTRAL_CALLER_ID=
# true = the salesperson presses 1 before the customer is dialled
RINGCENTRAL_PLAY_PROMPT=false

# HMAC secret for website/API leads (POST /api/public/leads). Leave blank to disable.
LEAD_WEBHOOK_SECRET=

# disabled | meta_cloud
WHATSAPP_PROVIDER=disabled
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Run background workers inside the API process (development only).
RUN_WORKERS_IN_API=true
